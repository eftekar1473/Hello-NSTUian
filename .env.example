# Server Configuration
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hello_nstuian?schema=public

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_this_session_cookie_secret

# Institutional EduMail Restriction (comma-separated domains)
ALLOWED_EDUMAIL_DOMAINS=nstu.edu.bd

# File Storage Configuration
# Uses local safe storage by default in development; can be configured for Supabase Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Supabase Storage (Production / Cloud Object Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=question-papers

# Email / SMTP (for EduMail verification code or links)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hello NSTUian <noreply@nstu.edu.bd>"
