{
  "name": "hello-nstuian-server",
  "version": "1.0.0",
  "description": "Backend API for Hello NSTUian academic question bank",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.js",
    "prisma:postgres:generate": "prisma generate --schema=./prisma/schema.postgresql.prisma",
    "prisma:postgres:push": "prisma db push --schema=./prisma/schema.postgresql.prisma",
    "prisma:postgres:migrate": "prisma migrate deploy --schema=./prisma/schema.postgresql.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
